---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";
import LoadingAnimation from "@/components/global/LoadingAnimation.astro"; // Import the new component
---

<html lang="en">
  <head>
    <BaseHead />
  </head>

  <body class="bg-black text-white"> {/* Added text-white for base visibility */}
    <LoadingAnimation /> {/* Add the loading animation */}
    {/* Navigation component handles its own initial opacity */}
    <Navigation />
    {/* Main content starts hidden */}
    <main id="main-content" class="opacity-0">
      <slot />
    </main>
    {/* Footer component's root is targeted, starts hidden via GSAP */}
    <Footer />

    {/* Background Audio Player */}
    {/* IMPORTANT: Replace 'public/audio/background.mp3' with your actual audio file path */}
    {/* Ensure the audio file exists in the 'public/audio/' directory */}
    <audio id="background-audio" loop>
      <source src="/audio/background.mp3" type="audio/mpeg">
      Your browser does not support the audio element.
    </audio>

    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
  </body>
</html>
