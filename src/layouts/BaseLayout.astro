---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";
import LoadingAnimation from "@/components/global/LoadingAnimation.astro"; // Import the new component
---

<html lang="en">
  <head>
    <BaseHead />
  </head>

  <body class="bg-black text-white"> {/* Added text-white for base visibility */}
    <LoadingAnimation /> {/* Add the loading animation */}
    {/* Consider hiding Nav/Footer until load? Or style them appropriately */}
    <Navigation />
    <main id="main-content"> {/* Wrap slot in main */}
      <slot />
    </main>
    <Footer />
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
  </body>
</html>
