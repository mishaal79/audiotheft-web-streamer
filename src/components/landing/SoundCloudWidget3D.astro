---
// Placeholder for the 3D SoundCloud Widget
// This will eventually contain Three.js logic
---
<div id="soundcloud-widget-3d-container" class="relative w-full h-screen bg-gray-900"> {/* Added a dark bg */}
  {/* Canvas for Three.js will be added here via script */}
  {/* Removed placeholder text */}
</div>

<script client:load>
  import * as THREE from 'three';

  console.log("3D Widget script loaded. Initializing basic Three.js scene.");

  const container = document.getElementById('soundcloud-widget-3d-container');

  // Function to fetch track data
  async function fetchTracks() {
    try {
      const response = await fetch('/api/soundcloud-tracks.json');
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      const tracks = await response.json();
      console.log("Fetched SoundCloud Tracks:", tracks);
      // TODO: Use this 'tracks' data to create 3D elements
      return tracks;
    } catch (error) {
      console.error("Failed to fetch SoundCloud tracks:", error);
      return null; // Return null or empty array on error
    }
  }

  // Main async function to initialize the scene
  async function initScene() {
    if (!container) {
      console.error("Container for 3D widget not found.");
      return;
    }

    // Fetch tracks first
    const tracks = await fetchTracks();
    if (!tracks || tracks.length === 0) {
      console.warn("No tracks fetched or available, skipping track visualization.");
      // Optionally display a message in the 3D scene
    }

    // Scene setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera( 75, container.clientWidth / container.clientHeight, 0.1, 1000 );
    const renderer = new THREE.WebGLRenderer({ antialias: true }); // Enable antialiasing
    renderer.setSize( container.clientWidth, container.clientHeight );
    renderer.setPixelRatio(window.devicePixelRatio); // Adjust for screen resolution
    container.appendChild( renderer.domElement );

    // Deck Surface (Plane)
    const planeGeometry = new THREE.PlaneGeometry( 10, 10 ); // Adjust size as needed
    const planeMaterial = new THREE.MeshStandardMaterial({
      color: 0x222222, // Dark grey
      metalness: 0.6,  // Somewhat metallic
      roughness: 0.4   // Somewhat rough
    });
    const deckPlane = new THREE.Mesh( planeGeometry, planeMaterial );
    deckPlane.rotation.x = -Math.PI / 2; // Rotate plane to be horizontal
    scene.add( deckPlane );

    // Optional: Add a grid helper for orientation
    const gridHelper = new THREE.GridHelper( 10, 10 ); // Size matches plane
    scene.add( gridHelper );


    // Basic lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6); // Slightly brighter ambient
    scene.add(ambientLight);
    const pointLight = new THREE.PointLight(0xffffff, 1, 100);
    pointLight.position.set(5, 5, 5);
    scene.add(pointLight);


    // Adjust camera position to look down onto the plane
    camera.position.set(0, 8, 5); // Positioned above and slightly back
    camera.lookAt(0, 0, 0); // Look at the center of the scene

    // Texture Loader
    const textureLoader = new THREE.TextureLoader();
    const placeholderTexture = textureLoader.load('/placeholder-art.png'); // Load placeholder

    // Create visuals for tracks if data exists
    const trackMeshes = []; // To store meshes for interaction later
    if (tracks) {
        const trackGeometry = new THREE.PlaneGeometry(1.5, 1.5); // Size of track representation
        const spacing = 2.0; // Spacing between tracks
        const startX = -((tracks.length - 1) * spacing) / 2; // Calculate starting position for centering

        tracks.forEach((track, index) => {
            // TODO: Load actual track.artwork_url when available
            const trackMaterial = new THREE.MeshBasicMaterial({ map: placeholderTexture, side: THREE.DoubleSide });
            const trackMesh = new THREE.Mesh(trackGeometry, trackMaterial);

            // Position the track plane on the deck
            trackMesh.position.set(startX + index * spacing, 0.05, 0); // Slightly above the deck plane
            // Keep it flat on the deck (no rotation needed if deck is at y=0 and plane is created in xy)
            // trackMesh.rotation.x = -Math.PI / 2; // Only needed if plane geometry is oriented differently

            scene.add(trackMesh);
            trackMeshes.push({ mesh: trackMesh, trackData: track }); // Store mesh and data
        });
    }


    // Animation loop (remove cube rotation)
    function animate() {
      requestAnimationFrame( animate );

      // No automatic rotation for now
      // cube.rotation.x += 0.01;
      // cube.rotation.y += 0.01;

      renderer.render( scene, camera );
    }

    animate();

    // Handle window resize
    function onWindowResize() {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }
    window.addEventListener('resize', onWindowResize, false);

    // Start the animation loop
    animate();

  } // End of initScene function

  // Call the main initialization function
  initScene();

</script>
