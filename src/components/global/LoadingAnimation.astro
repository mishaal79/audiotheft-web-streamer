---
// Placeholder for loading animation logic (e.g., using GSAP)
---
<div id="loading-overlay" class="fixed inset-0 bg-black z-50 flex items-center justify-center text-white">
  <p>Loading...</p>
  <!-- Animation elements will go here -->
</div>

<script>
  import { gsap } from 'gsap';

  const overlay = document.getElementById("loading-overlay");
  const logo = document.getElementById("loading-logo");
  const mainContent = document.getElementById("main-content");
  const navigation = document.getElementById("main-navigation"); // Use ID selector
  const footer = document.querySelector("footer"); // Footer uses tag selector

  function startAnimationSequence() {
    // Ensure elements exist
    if (!overlay || !logo || !mainContent || !navigation || !footer) {
      console.error("Loader or content elements not found!");
      // Fallback: just remove overlay if elements are missing
      overlay?.remove();
      // Ensure content is visible if loader fails
      gsap.set([mainContent, navigation, footer], { opacity: 1 });
      return;
    }

    // Initially hide main content, nav, footer (Nav opacity is also set in its component)
    gsap.set([mainContent, footer], { opacity: 0 }); // Only set main/footer here

    // Sequence: Fade logo in, wait, fade overlay out, then fade content in
    const tl = gsap.timeline({
      onComplete: () => {
        overlay.remove(); // Remove overlay from DOM after animation
        // Attempt to play audio - NOTE: May be blocked by browser until user interaction
        const audio = document.getElementById('background-audio') as HTMLAudioElement | null;
        audio?.play().catch(e => console.warn("Audio autoplay blocked:", e));
      }
    });

    tl.to(logo, { opacity: 1, duration: 0.8, ease: "power1.inOut" }) // Fade logo in
      .to(logo, { duration: 0.5 }) // Hold logo visibility
      .to(overlay, { opacity: 0, duration: 0.6, ease: "power1.inOut" }) // Fade overlay out
      .to([navigation, mainContent, footer], { opacity: 1, duration: 0.5, stagger: 0.1 }); // Fade content in
  }


  // Trigger sequence on window load (adjust trigger as needed)
  window.addEventListener('load', startAnimationSequence);

</script>

<style>
  /* Basic styling for the overlay */
  #loading-overlay {
    /* Add transition styles if using CSS transitions */
    transition: opacity 0.5s ease-out;
  }
</style>
